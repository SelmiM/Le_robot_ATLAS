# ============================================================================
#  EmbedWeb.cmake  --  turns the files in robot/web/ into a C++ header.
#
#  The Pico has no file system. To serve a web page it has to carry the page
#  inside the program itself, as an array of bytes, like any other constant.
#  This script writes that array: every file in web/ becomes
#
#      static const uint8_t web_index_html[] = {0x3c,0x21,0x64,...};
#
#  plus one table, WEB_FILES, that WebRadio.h looks paths up in.
#
#  CMakeLists.txt runs it whenever a file in web/ changes, so you edit the
#  page as an ordinary .html file and never touch the generated header.
#
#      cmake -DWEB_DIR=robot/web -DOUT=build/generated/WebFiles.h -P EmbedWeb.cmake
# ============================================================================

file(GLOB files RELATIVE ${WEB_DIR} ${WEB_DIR}/*)
list(SORT files)

set(arrays "")
set(table "")

foreach(name ${files})
    if(IS_DIRECTORY ${WEB_DIR}/${name})
        continue()
    endif()

    # What the browser is told the file is. Anything else is served as bytes.
    get_filename_component(extension ${name} LAST_EXT)
    if(extension STREQUAL ".html")
        set(type "text/html; charset=utf-8")
    elseif(extension STREQUAL ".js")
        set(type "text/javascript; charset=utf-8")
    elseif(extension STREQUAL ".css")
        set(type "text/css; charset=utf-8")
    elseif(extension STREQUAL ".svg")
        set(type "image/svg+xml")
    else()
        set(type "application/octet-stream")
    endif()

    string(MAKE_C_IDENTIFIER "web_${name}" id)

    file(READ ${WEB_DIR}/${name} hex HEX)
    string(LENGTH "${hex}" digits)
    math(EXPR size "${digits} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")

    string(APPEND arrays "// ${name}, ${size} bytes\nstatic const uint8_t ${id}[] = {${bytes}};\n\n")
    string(APPEND table "  {\"/${name}\", \"${type}\", ${id}, ${size}},\n")
endforeach()

set(header "// GENERATED by robot/EmbedWeb.cmake from the files in robot/web/.
// Do not edit: edit those files and rebuild.
#pragma once
#include <cstddef>
#include <cstdint>

struct WebFile {
  const char*    path;   // \"/index.html\"
  const char*    type;   // what to put in Content-Type
  const uint8_t* data;
  size_t         size;
};

${arrays}static const WebFile WEB_FILES[] = {
${table}};
")

# Only rewrite the header when it actually changed, so that an unrelated
# rebuild does not recompile main.cpp for nothing.
if(EXISTS ${OUT})
    file(READ ${OUT} previous)
endif()
if(NOT "${previous}" STREQUAL "${header}")
    file(WRITE ${OUT} "${header}")
endif()
